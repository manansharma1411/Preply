{
  "name": "preply-root",
  "version": "1.0.0",
  "private": true,
  "description": "Preply - AI-Powered Student Workspace",
  "scripts": {
    "start": "npm --prefix backend start",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "test": "npm --prefix backend run test && npm --prefix frontend run test"
  },
  "keywords": [
    "education",
    "ai",
    "student-workspace",
    "quiz",
    "gemini"
  ],
